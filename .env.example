# Copy this file to .env for a PROJECT-LOCAL config (only applies when you
# run `aura` from this directory). For a GLOBAL config that works from
# anywhere, run `aura --init` instead — it creates this same file at the
# right OS-specific location (~/.config/aura/.env on Linux, %LOCALAPPDATA%\aura\.env on Windows).

# ── Provider selection ──────────────────────────────────────────────
# "ollama" = free, runs locally, no API key needed (recommended to start)
# "openai" = OpenAI's cloud API, needs OPENAI_API_KEY, costs money per call
AURA_PROVIDER=ollama

# Model name. Good local defaults: qwen3:8b, llama3.1:8b, mistral:7b
# Good OpenAI defaults: gpt-4o-mini, gpt-4o
AURA_MODEL=qwen3:8b

# ── Ollama (only used when AURA_PROVIDER=ollama) ────────────────────
# Default assumes `ollama serve` running locally with its OpenAI-compatible API.
OLLAMA_BASE_URL=http://localhost:11434/v1

# ── OpenAI (only used when AURA_PROVIDER=openai) ────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── GitHub (optional, only needed for github_* tools) ───────────────
# Create a fine-grained personal access token scoped to only the repos
# you want this agent to touch: https://github.com/settings/tokens
GITHUB_TOKEN=

# ── Safety ───────────────────────────────────────────────────────────
# If false, ALL confirmation prompts are skipped (not recommended).
AURA_REQUIRE_CONFIRMATION=true

# Space-separated allowlist for the restricted run_shell fallback tool.
AURA_SHELL_ALLOWLIST=git docker npm pytest python python3

# Where persistent agent memory (remembered facts) is stored.
# Default (if unset) is the OS-correct app-data location via platformdirs —
# only set this if you want to override it.
# AURA_MEMORY_PATH=~/.aura/memory.json

# Max tool-call round-trips per user turn before the agent gives up.
AURA_MAX_TOOL_ITERATIONS=8
